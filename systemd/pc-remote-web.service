[Unit]
Description=PC Remote web app
# Hyprland's environment reaches systemd once the graphical session starts.
# Starting with it lets the zoom lens see HYPRLAND_INSTANCE_SIGNATURE.
After=graphical-session.target pipewire.service wireplumber.service
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/pc-remote-web
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Settings live in ~/.config/pc-remote/config.toml; see the README.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
