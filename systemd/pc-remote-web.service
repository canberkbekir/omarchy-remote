[Unit]
Description=PC Remote web app
After=pipewire.service wireplumber.service

[Service]
ExecStart=%h/.local/bin/pc-remote-web
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Settings live in ~/.config/pc-remote/config.toml; see the README.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
